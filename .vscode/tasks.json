{
  "version": "2.0.0",
  "tasks": [{
    "label": "build", "dependsOn": ["build core", "build extension"],
    "group": { "kind": "build", "isDefault": true }
  }, {
    "label": "build core", "type": "process", "command": "cargo",
    "args": ["build", "--manifest-path", "core-rust/Cargo.toml"], "problemMatcher": ["$rustc"]
  }, {
    "label": "build extension", "type": "shell", "command": "npm run compile",
    "options": { "cwd": "${workspaceFolder}/extension" }, "problemMatcher": ["$tsc"]
  }]
}
